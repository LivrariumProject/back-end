{
  "name": "back-end",
  "version": "1.0.0",
  "description": "O Livrarium Project é uma plataforma de biblioteca virtual criada com o objetivo de facilitar o acesso, organização e descoberta de livros digitais. O sistema será dividido em frontend e backend, permitindo uma arquitetura mais clara, modular e alinhada às boas práticas de desenvolvimento.",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "DB_NAME=livrarium_test jest --detectOpenHandles --forceExit --runInBand",
    "test:watch": "DB_NAME=livrarium_test jest --watch --runInBand",
    "test:coverage": "DB_NAME=livrarium_test jest --coverage --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LivrariumProject/back-end.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LivrariumProject/back-end/issues"
  },
  "homepage": "https://github.com/LivrariumProject/back-end#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}